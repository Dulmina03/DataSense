<Window x:Class="DataSense.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataSense.UI"
        xmlns:viewmodels="clr-namespace:DataSense.UI.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:converters="clr-namespace:DataSense.UI.Converters"
        mc:Ignorable="d"
        Title="Data Usage &amp; Traffic Analyzer" Height="780" Width="1220" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/datasense_icon.png"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        Background="#0B1220"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation (Width controlled by IsSidebarCollapsed) -->
            <ColumnDefinition Width="Auto"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="230"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="70"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand / Title -->
                    <RowDefinition Height="70"/>
                    <!-- Menu Navigation List -->
                    <RowDefinition Height="*"/>
                    <!-- App Health Status Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand logo and name -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <!-- Expanded brand row -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="ChartLineVariant" Width="26" Height="26" Foreground="{StaticResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="DataSense" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <!-- Collapsed: icon only centered -->
                    <materialDesign:PackIcon Kind="ChartLineVariant" Width="28" Height="28" Foreground="{StaticResource PrimaryHueMidBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <!-- Sidebar navigation items -->
                <ListBox Grid.Row="1" 
                         SelectedIndex="{Binding SelectedTabIndex}"
                         Background="Transparent" 
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource MaterialDesignListBoxItem}">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="20,14"/>
                            <Setter Property="Foreground" Value="#718096"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="{StaticResource SidebarSelectedBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>

                    <!-- Dashboard -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="ViewDashboardOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Dashboard" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- History -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="ChartBoxOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="History" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Alerts -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AlertCircleOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Alerts" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Time Period Usage -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="ClockOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Time Period Usage" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Speed Test -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Speedometer" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Speed Test" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Settings -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="SettingsOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                </ListBox>

                <!-- Sidebar footer status -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#1A202C" Padding="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="#00E5FF"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Npcap Active" Foreground="#A0AEC0" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORK AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header Bar -->
                <RowDefinition Height="70"/>
                <!-- Tab Switching Panel -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource MainHeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="#1A202C">
                <Grid Margin="12,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Toggle Button (small and simple DockLeft icon) -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            Foreground="#A0AEC0"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            ToolTip="Toggle Sidebar">
                        <materialDesign:PackIcon Kind="DockLeft" Width="18" Height="18"/>
                    </Button>

                    <!-- Title based on navigation selection -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Text" Value="Data Usage &amp; Traffic Analyzer"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Text" Value="Historical Reports &amp; Logs"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Text" Value="Data Limit Threshold Settings"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                        <Setter Property="Text" Value="Time Period Usage"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                        <Setter Property="Text" Value="Net Speed Testing"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                        <Setter Property="Text" Value="System Preferences &amp; Config"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- SILENT TAB CONTROL (Content switcher) -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 0: DASHBOARD REDESIGN (LAYOUT ONLY) -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">

                            <!-- HEADER -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="DataSense" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Network Usage Monitor" FontSize="14" Foreground="#718096" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- ROW 1: SIX SUMMARY CARDS -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Download -->
                                <materialDesign:Card Grid.Column="0" CornerRadius="18" BorderThickness="1" BorderBrush="#66FFFFFF33" Background="{StaticResource MaterialDesignCardBackground}" Padding="14" Margin="0,0,6,0">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <materialDesign:PackIcon Kind="Download" Width="24" Height="24" Foreground="#00E5FF" HorizontalAlignment="Center" />
    <TextBlock Grid.Row="1" Text="{Binding DownloadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" />
    <TextBlock Grid.Row="2" Text="Total Downloaded" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,4,0,0" />
  </Grid>
  <materialDesign:Card.Style>
    <Style TargetType="materialDesign:Card">
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect">
            <Setter.Value>
              <DropShadowEffect BlurRadius="8" ShadowDepth="4" Opacity="0.5" />
            </Setter.Value>
          </Setter>
          <Setter Property="RenderTransform">
            <Setter.Value>
              <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </materialDesign:Card.Style>
</materialDesign:Card>
                                    <Grid>
                                      <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>
                                      <materialDesign:PackIcon Kind="Download" Width="24" Height="24" Foreground="#00E5FF" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="1" Text="{Binding DownloadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="2" Text="Total Downloaded" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                      <Border Grid.Row="3" Height="30" Margin="0,6,0,0" Background="#1A202C33" CornerRadius="4">
                                        <TextBlock Text="[Sparkline]" Foreground="#A0AEC0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                                      </Border>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- Card 2: Upload -->
                                <materialDesign:Card Grid.Column="1" Background="{StaticResource MaterialDesignCardBackground}" Padding="14" Margin="6,0,6,0">
                                    <Grid>
                                      <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>
                                      <materialDesign:PackIcon Kind="Upload" Width="24" Height="24" Foreground="#9C27B0" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="1" Text="{Binding UploadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="#9C27B0" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="2" Text="Total Uploaded" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                      <Border Grid.Row="3" Height="30" Margin="0,6,0,0" Background="#1A202C33" CornerRadius="4">
                                        <TextBlock Text="[Sparkline]" Foreground="#A0AEC0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                                      </Border>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- Card 3: Today Usage -->
                                <materialDesign:Card Grid.Column="2" Background="{StaticResource MaterialDesignCardBackground}" Padding="14" Margin="6,0,6,0">
                                    <Grid>
                                      <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>
                                      <materialDesign:PackIcon Kind="CalendarToday" Width="24" Height="24" Foreground="#FFB300" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="1" Text="{Binding DailyUsageText}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="2" Text="Today's Traffic" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </Grid>
                                </materialDesign:Card>

                                <!-- Card 4: This Month -->
                                <materialDesign:Card Grid.Column="3" Background="{StaticResource MaterialDesignCardBackground}" Padding="14" Margin="6,0,6,0">
                                    <Grid>
                                      <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>
                                      <materialDesign:PackIcon Kind="CalendarMonth" Width="24" Height="24" Foreground="#00B0FF" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="1" Text="{Binding MonthlyUsageText}" FontSize="28" FontWeight="Bold" Foreground="#00B0FF" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="2" Text="Monthly Traffic" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </Grid>
                                </materialDesign:Card>

                                <!-- Card 5: Active Apps -->
                                <materialDesign:Card Grid.Column="4" Background="{StaticResource MaterialDesignCardBackground}" Padding="14" Margin="6,0,6,0">
                                    <Grid>
                                      <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>
                                      <materialDesign:PackIcon Kind="Application" Width="24" Height="24" Foreground="#FF9800" HorizontalAlignment="Center" />
                                      <TextBlock Grid.Row="1" Text="{Binding ActiveAppsCount, FallbackValue='12'}" FontSize="28" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center" />
                                      <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="Display" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" />
                                        <TextBlock Text="5 Using Network" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" />
                                      </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- Card 6: Network -->
                                <materialDesign:Card Grid.Column="5" Background="{StaticResource MaterialDesignCardBackground}" Padding="14" Margin="6,0,0,0">
                                    <Grid>
                                      <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>
                                      <materialDesign:PackIcon Kind="Network" Width="24" Height="24" Foreground="#00E5FF" HorizontalAlignment="Center" />
                                      <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="↓95 Mbps" FontSize="20" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" />
                                        <TextBlock Text="↑22 Mbps" FontSize="20" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                      </StackPanel>
                                      <TextBlock Grid.Row="2" Text="Dialog Fiber" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </Grid>
                                </materialDesign:Card>
                            </Grid>

                            <!-- ROW 2: LIVE NETWORK (70%) & NETWORK OVERVIEW (30%) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left 70%: Live Network Traffic -->
                         <materialDesign:Card Grid.Column="0" Padding="16">
    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#66FFFFFF33" Background="{StaticResource MaterialDesignCardBackground}">
      <StackPanel>
        <TextBlock Text="Today" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
        <!-- Doughnut Chart placeholder -->
        <Border Height="180" Width="180" Background="#2D3748" CornerRadius="90" HorizontalAlignment="Center" Margin="0,0,0,12">
          <TextBlock Text="[Doughnut Chart]" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Today's Total" Foreground="#718096" FontSize="12"/>
        <TextBlock Text="42.8 GB" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <!-- Legend -->
        <StackPanel>
          <TextBlock Text="Steam 67% 12.8 GB" Foreground="White"/>
          <TextBlock Text="Chrome 12% 2.2 GB" Foreground="White"/>
          <TextBlock Text="OneDrive 5% 1.0 GB" Foreground="White"/>
          <TextBlock Text="Discord 3% 0.5 GB" Foreground="White"/>
          <TextBlock Text="Others 13% 2.5 GB" Foreground="White"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </materialDesign:Card>

                                <!-- Right 30%: Network Overview -->
                             <materialDesign:Card Grid.Column="2" Background="{StaticResource MaterialDesignCardBackground}" Padding="16">
    <StackPanel>
        <TextBlock Text="Network Overview" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Network" Foreground="#718096" FontSize="12"/>
            <TextBlock Text="Wi‑Fi 6" Foreground="White" FontSize="12" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="SSID" Foreground="#718096" FontSize="12"/>
            <TextBlock Text="Dialog Fiber" Foreground="White" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
        </Grid>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Download Speed" Foreground="#718096" FontSize="12"/>
            <TextBlock Text="95 Mbps" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Upload Speed" Foreground="#718096" FontSize="12"/>
            <TextBlock Text="22 Mbps" Foreground="#00E676" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Ping" Foreground="#718096" FontSize="12"/>
            <TextBlock Text="14 ms" Foreground="White" FontSize="12" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,0,0,0">
            <TextBlock Text="Signal Strength" Foreground="#718096" FontSize="12"/>
            <TextBlock Text="Excellent" Foreground="#00E676" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</materialDesign:Card>
                            </Grid>

                            <!-- ROW 3: PROCESS NETWORK TRAFFIC -->
                            <materialDesign:Card Background="{StaticResource MaterialDesignCardBackground}" Padding="16" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Process Network Traffic" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                    
                            <ListView ItemsSource="{Binding TopProcesses}" MaxHeight="220">
    <ListView.View>
        <GridView>
            <!-- Application column with icon and name -->
            <GridViewColumn Header="Application">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4">
                            <materialDesign:PackIcon Kind="Application" Width="16" Height="16" Foreground="White" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ProcessName}" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <!-- Live Speed column showing download (blue) and upload (purple) -->
            <GridViewColumn Header="Live Speed">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#00E5FF" FontWeight="Bold"/>
                            <TextBlock Text="{Binding UploadSpeedText}" Foreground="#00E676" FontWeight="Bold"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <!-- Trend column with small sparkline placeholder -->
            <GridViewColumn Header="Trend">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <Border Height="20" Width="80" Background="#2D3748" CornerRadius="3">
                            <TextBlock Text="[spark]" Foreground="#A0AEC0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                        </Border>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>
    </ListView.View>
    <!-- Styling for rows: rounded corners, hover animation, subtle highlight -->
    <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A202C66"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A202C99"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListView.ItemContainerStyle>
</ListView>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- ROW 4: TOP DATA CONSUMERS (TWO EQUAL CARDS) -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Today -->
                                <materialDesign:Card Grid.Column="0" Padding="16">
                                     <Border CornerRadius="18" BorderThickness="1" BorderBrush="#66FFFFFF33" Background="{StaticResource MaterialDesignCardBackground}">
                                         <Border.Background>
                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                 <GradientStop Color="#0066FF" Offset="0"/>
                                                 <GradientStop Color="#800080" Offset="1"/>
                                             </LinearGradientBrush>
                                         </Border.Background>
                                         <Grid>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto"/>
                                                 <RowDefinition Height="220"/>
                                             </Grid.RowDefinitions>
                                             <TextBlock Grid.Row="0" Text="Live Network Traffic" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                             <lvc:CartesianChart Grid.Row="1"
                                                 Series="{Binding SpeedSeries}"
                                                 XAxes="{Binding SpeedXAxes}"
                                                 YAxes="{Binding SpeedYAxes}"
                                                 DrawMarginFrame="{Binding SpeedDrawMarginFrame}"
                                                 LegendLocation="None"
                                                 Hoverable="True"
                                                 ZoomMode="X"
                                                 GridLinesVisibility="Vertical,Horizontal"
                                                 StrokeThickness="2"/>
                                         </Grid>
                                     </Border>
                                 </materialDesign:Card>

                                <!-- Card 2: Monthly -->
                                <materialDesign:Card Grid.Column="2" Background="{StaticResource MaterialDesignCardBackground}" Padding="16">
                                    <StackPanel Height="180">
                        <materialDesign:Card Grid.Column="2" Padding="16">
  <Border CornerRadius="18" BorderThickness="1" BorderBrush="#66FFFFFF33" Background="{StaticResource MaterialDesignCardBackground}">
    <StackPanel>
      <TextBlock Text="This Month" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
      <!-- Doughnut Chart placeholder -->
      <Border Height="180" Width="180" Background="#2D3748" CornerRadius="90" HorizontalAlignment="Center" Margin="0,0,0,12">
        <TextBlock Text="[Doughnut Chart]" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Monthly Total" Foreground="#718096" FontSize="12"/>
      <TextBlock Text="486.5 GB" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
      <!-- Legend -->
      <StackPanel>
        <TextBlock Text="Steam 42% 124.8 GB" Foreground="White"/>
        <TextBlock Text="OneDrive 21% 61.5 GB" Foreground="White"/>
        <TextBlock Text="Chrome 15% 45.3 GB" Foreground="White"/>
        <TextBlock Text="Windows Update 11% 33.2 GB" Foreground="White"/>
        <TextBlock Text="Others 11% 32.7 GB" Foreground="White"/>
      </StackPanel>
    </StackPanel>
  </Border>
</materialDesign:Card>                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 1: HISTORY VIEW -->
                <TabItem DataContext="{Binding History}">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*" MinHeight="200"/>
                            <RowDefinition Height="2*" MinHeight="140"/>
                            <RowDefinition Height="Auto" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <!-- Controls Panel -->
                        <materialDesign:Card Grid.Row="0" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,0,0,20" Padding="16">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="Year:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Foreground="White" Width="85" Margin="0,0,20,0"/>
                                    
                                    <TextBlock Text="Month:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding MonthOptions}" SelectedIndex="{Binding SelectedMonthIndex}" Foreground="White" Width="120" Margin="0,0,20,0"/>
                                    
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding LoadCommand}" Content="Load Logs" Width="100"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Command="{Binding ExportToCsvCommand}" ToolTip="Export Current Log to CSV" Foreground="{StaticResource PrimaryHueMidBrush}" BorderBrush="{StaticResource PrimaryHueMidBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocument" Margin="0,0,6,0"/>
                                            <TextBlock Text="CSV"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding ExportToPdfCommand}" ToolTip="Export Current Log to PDF" Foreground="{StaticResource PrimaryHueMidBrush}" BorderBrush="{StaticResource PrimaryHueMidBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocument" Margin="0,0,6,0"/>
                                            <TextBlock Text="PDF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </materialDesign:Card>

                        <!-- Historical Daily Chart -->
                        <materialDesign:Card Grid.Row="1" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,0,0,20" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Daily Usage Breakdown (GB)" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding DailyChartSeries}"
                                                    XAxes="{Binding XAxes}"
                                                    YAxes="{Binding YAxes}"
                                                    DrawMarginFrame="{Binding HistoryDrawMarginFrame}"
                                                    Background="Transparent"
                                                    MinHeight="160"/>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Grid for Tables -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="260"/>
                                <ColumnDefinition Width="1*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>

                            <!-- Daily details table -->
                            <materialDesign:Card Grid.Column="0" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,0,16,0" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Daily Breakdown Logs" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                                    <ListView Grid.Row="1" ItemsSource="{Binding DailyRows}">
                                        <ListView.View>
                                        <GridView>
                                                <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" Width="Auto"/>
                                                <GridViewColumn Header="Downloaded" DisplayMemberBinding="{Binding Downloaded}" Width="Auto"/>
                                                <GridViewColumn Header="Uploaded" DisplayMemberBinding="{Binding Uploaded}" Width="Auto"/>
                                                <GridViewColumn Header="Total" DisplayMemberBinding="{Binding Total}" Width="Auto"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </materialDesign:Card>

                            <!-- Process summary table -->
                             <materialDesign:Card Grid.Column="1" Background="{StaticResource MaterialDesignCardBackground}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Monthly Per-App Breakdown" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                                    <ListView Grid.Row="1" ItemsSource="{Binding ProcessRows}">
                                        <ListView.View>
                                        <GridView>
                                                <GridViewColumn Header="Application" DisplayMemberBinding="{Binding ProcessName}" Width="Auto"/>
                                                <GridViewColumn Header="↓ DL" DisplayMemberBinding="{Binding DownloadedText}" Width="Auto"/>
                                                <GridViewColumn Header="↑ UL" DisplayMemberBinding="{Binding UploadedText}" Width="Auto"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </materialDesign:Card>
                        </Grid>

                        <!-- Network Usage Table (Row 3) -->
                        <materialDesign:Card Grid.Row="3" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,16,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Card Header with Title & Month/Year Selectors -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Wifi" Foreground="#00E5FF" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Usage by Network" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Quick Month & Year Selector inside Card -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Month:" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding MonthOptions}" SelectedIndex="{Binding SelectedMonthIndex}" Foreground="White" Width="110" Margin="0,0,12,0" FontSize="12"/>
                                        
                                        <TextBlock Text="Year:" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Foreground="White" Width="75" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Sub Tabs: Daily Usage & Monthly Usage -->
                                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                    <!-- TAB 1: DAILY USAGE -->
                                    <TabItem Header="Daily Usage (Today)" Foreground="#00E5FF">
                                        <Grid Margin="0,12,0,0">
                                            <ListView ItemsSource="{Binding NetworkRows}" MaxHeight="180">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Network / Wi-Fi SSID" DisplayMemberBinding="{Binding NetworkName}" Width="260"/>
                                                        <GridViewColumn Header="↓ Downloaded" DisplayMemberBinding="{Binding Downloaded}" Width="130"/>
                                                        <GridViewColumn Header="↑ Uploaded" DisplayMemberBinding="{Binding Uploaded}" Width="130"/>
                                                        <GridViewColumn Header="Total" DisplayMemberBinding="{Binding Total}" Width="120"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </Grid>
                                    </TabItem>

                                    <!-- TAB 2: MONTHLY USAGE -->
                                    <TabItem Header="Monthly Usage (Selected Month)" Foreground="#34D399">
                                        <Grid Margin="0,12,0,0">
                                            <ListView ItemsSource="{Binding MonthlyNetworkRows}" MaxHeight="180">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Network / Wi-Fi SSID" DisplayMemberBinding="{Binding NetworkName}" Width="260"/>
                                                        <GridViewColumn Header="↓ Downloaded" DisplayMemberBinding="{Binding Downloaded}" Width="130"/>
                                                        <GridViewColumn Header="↑ Uploaded" DisplayMemberBinding="{Binding Uploaded}" Width="130"/>
                                                        <GridViewColumn Header="Total" DisplayMemberBinding="{Binding Total}" Width="120"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- TAB 2: DATA LIMITS VIEW -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Limit Settings Card -->
                        <materialDesign:Card Grid.Row="0" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,0,0,24" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Set Monthly Data Cap" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="White"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Monthly Limit (GB):" VerticalAlignment="Center" FontSize="15" Margin="0,0,16,0" Foreground="White"/>
                                    <TextBox Grid.Column="1" Text="{Binding MonthlyLimitGb, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontSize="16" Foreground="White" materialDesign:TextFieldAssist.HasClearButton="True"/>
                                    <Button Grid.Column="2" Command="{Binding SaveLimitCommand}" Content="Save Limit" Margin="16,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </Grid>

                                <Separator Margin="0,0,0,20" Background="#1A202C"/>

                                <TextBlock Text="Current Usage Cap Status" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="White"/>
                                <TextBlock Text="{Binding LimitUsageText}" FontSize="15" Margin="0,0,0,8" Foreground="{StaticResource PrimaryHueMidBrush}" FontWeight="SemiBold"/>
                                <ProgressBar Value="{Binding LimitUsagePercentage}" Height="12" Margin="0,0,0,8" Foreground="{StaticResource PrimaryHueMidBrush}" Background="#2D3748"/>
                                <Grid>
                                    <TextBlock Text="0%" HorizontalAlignment="Left" Foreground="Gray"/>
                                    <TextBlock Text="100%" HorizontalAlignment="Right" Foreground="Gray"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Threshold alert logs card -->
                        <materialDesign:Card Grid.Row="1" Background="{StaticResource MaterialDesignCardBackground}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Configured Alerts Thresholds" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Alert" Foreground="Green" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="50% Threshold Notification Alert active." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Alert" Foreground="Orange" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="75% Warning notification alert active." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Alert" Foreground="Red" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="90% Critical Alert notification active." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="DarkRed" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="100% Data Cap Reached notification and system action ready." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="You will receive real-time notifications in your system tray balloon tip when limits are breached." Foreground="Gray" FontSize="11" Margin="0,20,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>


                <!-- TAB 3: TIME PERIOD USAGE -->
                <TabItem>
                    <Grid Margin="24">
                        <!-- Query Card -->
                        <materialDesign:Card Background="{StaticResource MaterialDesignCardBackground}" Padding="24">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- START TIME -->
                                    <TextBlock Text="START TIME" Foreground="#718096" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border Background="#1A2535" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Hour -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding CustomStartHour, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="White" FontSize="26" FontWeight="Bold"
                                                     Width="45" TextAlignment="Center"
                                                     MaxLength="2"
                                                     materialDesign:HintAssist.Hint="hh"
                                                     Style="{StaticResource MaterialDesignTextBox}"
                                                     CaretBrush="White" VerticalAlignment="Center"/>

                                            <!-- Colon -->
                                            <TextBlock Grid.Column="1" Text=":" Foreground="#00E5FF" FontSize="26" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="4,0"/>

                                            <!-- Minute -->
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding CustomStartMinute, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="White" FontSize="26" FontWeight="Bold"
                                                     Width="45" TextAlignment="Center"
                                                     MaxLength="2"
                                                     materialDesign:HintAssist.Hint="mm"
                                                     Style="{StaticResource MaterialDesignTextBox}"
                                                     CaretBrush="White" VerticalAlignment="Center"/>

                                            <!-- AM/PM -->
                                            <ComboBox Grid.Column="4"
                                                      ItemsSource="{Binding AmPmOptions}"
                                                      SelectedItem="{Binding CustomStartAmPm}"
                                                      Foreground="#00E5FF"
                                                      FontWeight="Bold" FontSize="15"
                                                      Width="70"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#00E5FF" FontWeight="Bold" FontSize="15"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Arrow between times -->
                                    <materialDesign:PackIcon Kind="ArrowDown" Foreground="#4A5568" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                    <!-- END TIME -->
                                    <TextBlock Text="END TIME" Foreground="#718096" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border Background="#1A2535" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Hour -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding CustomEndHour, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="White" FontSize="26" FontWeight="Bold"
                                                     Width="45" TextAlignment="Center"
                                                     MaxLength="2"
                                                     materialDesign:HintAssist.Hint="hh"
                                                     Style="{StaticResource MaterialDesignTextBox}"
                                                     CaretBrush="White" VerticalAlignment="Center"/>

                                            <!-- Colon -->
                                            <TextBlock Grid.Column="1" Text=":" Foreground="#E91E63" FontSize="26" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="4,0"/>

                                            <!-- Minute -->
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding CustomEndMinute, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="White" FontSize="26" FontWeight="Bold"
                                                     Width="45" TextAlignment="Center"
                                                     MaxLength="2"
                                                     materialDesign:HintAssist.Hint="mm"
                                                     Style="{StaticResource MaterialDesignTextBox}"
                                                     CaretBrush="White" VerticalAlignment="Center"/>

                                            <!-- AM/PM -->
                                            <ComboBox Grid.Column="4"
                                                      ItemsSource="{Binding AmPmOptions}"
                                                      SelectedItem="{Binding CustomEndAmPm}"
                                                      Foreground="#E91E63"
                                                      FontWeight="Bold" FontSize="15"
                                                      Width="70"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#E91E63" FontWeight="Bold" FontSize="15"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Query Button -->
                                    <Button Content="Check Usage"
                                            Command="{Binding QueryCustomPeriodUsageCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource PrimaryHueMidBrush}"
                                            Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                            Height="42"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Margin="0,0,0,16"/>

                                    <!-- Info / Validation Message -->
                                    <TextBlock Text="{Binding CustomPeriodInfoText}"
                                               Foreground="#718096"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16"
                                               Visibility="{Binding CustomPeriodInfoText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                                    <Border BorderThickness="0,1,0,0" BorderBrush="#2D3748" Padding="0,16,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Download -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <TextBlock Text="Downloaded:" Foreground="#718096" FontSize="13"/>
                                                <TextBlock Text="{Binding CustomPeriodDownloadedText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" FontSize="13"/>
                                            </Grid>

                                            <!-- Upload -->
                                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                                <TextBlock Text="Uploaded:" Foreground="#718096" FontSize="13"/>
                                                <TextBlock Text="{Binding CustomPeriodUploadedText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" FontSize="13"/>
                                            </Grid>

                                            <!-- Total -->
                                            <Grid Grid.Row="2">
                                                <TextBlock Text="Total Usage:" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding CustomPeriodTotalText}" Foreground="#00E5FF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="16"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- TAB 4: SPEED TEST -->
                <TabItem>
                    <Grid Margin="24">
                        <!-- Speed Test Card -->
                        <materialDesign:Card Background="{StaticResource MaterialDesignCardBackground}" Padding="24">
                            <Grid HorizontalAlignment="Center" MaxWidth="560">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Gauge circle -->
                                <Viewbox Grid.Row="0" Stretch="Uniform" MaxWidth="280" MaxHeight="280"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Margin="12">
                                    <Grid Width="200" Height="200">
                                        <Ellipse Width="190" Height="190" Stroke="#1A2035" StrokeThickness="14"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="190" Height="190" Stroke="#00E5FF" StrokeThickness="8" Opacity="0.25"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SpeedTestCurrentSpeedText}" FontSize="32" FontWeight="Black"
                                                       Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="MBps" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SpeedTestPhase}" FontSize="10" Foreground="#718096"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Ellipse Width="198" Height="198" Stroke="#00E5FF" StrokeThickness="2.5" Opacity="0.4"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Visibility="{Binding IsSpeedTestRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform CenterX="99" CenterY="99"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             From="0" To="360" Duration="0:0:1.5"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>
                                </Viewbox>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Row="1" Value="{Binding SpeedTestProgress}" Maximum="100" Height="6"
                                             Margin="0,16,0,20" Foreground="#00E5FF" Background="#1A2035"/>

                                <!-- Metrics Grid -->
                                <Grid Grid.Row="2" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,12" HorizontalAlignment="Center">
                                        <TextBlock Text="Download" Foreground="#718096" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedTestDownloadText}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0,0,12" HorizontalAlignment="Center">
                                        <TextBlock Text="Upload" Foreground="#718096" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedTestUploadText}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Ping" Foreground="#718096" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedTestPingText}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Jitter" Foreground="#718096" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedTestJitterText}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Start / Abort Button -->
                                <Button Grid.Row="3" HorizontalAlignment="Stretch"
                                        Height="42"
                                        Command="{Binding RunSpeedTestCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#00E5FF" Foreground="#0A0F1E"
                                        FontWeight="Bold" FontSize="13">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Speedometer" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Start Speed Test"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeedTestRunning}" Value="True">
                                                            <Setter Property="Text" Value="Testing…"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- TAB 5: SETTINGS -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Preferences settings -->
                        <materialDesign:Card Grid.Row="0" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,0,0,24" Padding="24">
                            <StackPanel>
                                <TextBlock Text="General Preferences" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                                <!-- Startup Toggle -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start DataSense with Windows" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Automatically launches DataSense when your PC starts up to track all metrics." Foreground="Gray"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsStartupEnabled}" Command="{Binding ToggleStartupCommand}"/>
                                </Grid>

                                <Separator Margin="0,0,0,16" Background="#1A202C"/>

                                <!-- Dark Theme Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Enable Dark Theme Layout" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Switch background layout to a comfortable midnight slate theme." Foreground="Gray"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsDarkTheme}" Command="{Binding ToggleThemeCommand}"/>
                                </Grid>

                                <Separator Margin="0,16,0,16" Background="#1A202C"/>

                                <!-- Net Speed Meter Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Speedometer" Foreground="#4FC3F7" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Net Speed Meter Overlay" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Show a real-time transparent upload/download speed meter on your taskbar. Drag to reposition." Foreground="Gray" Margin="26,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsNetSpeedMeterEnabled}" Command="{Binding ToggleNetSpeedMeterCommand}"/>
                                </Grid>

                                <Separator Margin="0,16,0,16" Background="#1A202C"/>

                                <!-- Pin Net Speed Meter to Taskbar Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pin" Foreground="#EF5350" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Pin Speed Meter to Taskbar" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Locks the speed meter position directly onto the taskbar (next to the system tray clock)." Foreground="Gray" Margin="26,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsNetSpeedMeterPinned}" Command="{Binding ToggleNetSpeedMeterPinnedCommand}"/>
                                </Grid>

                                <Separator Margin="0,16,0,16" Background="#1A202C"/>

                                <!-- Customization Options (Color &amp; Size) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Palette" Foreground="#81C784" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Speed Meter Customization" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Configure the font color and text size of the speed overlay." Foreground="Gray" Margin="26,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Color Selection -->
                                        <ComboBox Width="110" Margin="0,0,12,0"
                                                  ItemsSource="{Binding NetSpeedMeterAvailableColors}"
                                                  SelectedItem="{Binding SelectedNetSpeedMeterColor}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Color"
                                                  Foreground="White"
                                                  BorderBrush="#33FFFFFF"/>
                                        <!-- Font Size Selection -->
                                        <ComboBox Width="80"
                                                  ItemsSource="{Binding NetSpeedMeterAvailableFontSizes}"
                                                  SelectedItem="{Binding SelectedNetSpeedMeterFontSize}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Size"
                                                  Foreground="White"
                                                  BorderBrush="#33FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Adapter Selection Card -->
                        <materialDesign:Card Grid.Row="1" Background="{StaticResource MaterialDesignCardBackground}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Select Network Adapter to Monitor" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="White"/>
                                <TextBlock Text="Choose which physical Ethernet or Wi-Fi adapter's raw packets will be captured by the Npcap engine:" Margin="0,0,0,16" Foreground="Gray"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableAdapters}" SelectedItem="{Binding SelectedAdapter}" FontSize="14" DisplayMemberPath="Name" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding ChangeAdapterCommand}" Content="Apply Adapter" Margin="16,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
