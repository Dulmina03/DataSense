<Window x:Class="DataSense.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataSense.UI"
        xmlns:viewmodels="clr-namespace:DataSense.UI.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:converters="clr-namespace:DataSense.UI.Converters"
        mc:Ignorable="d"
        Title="Data Usage &amp; Traffic Analyzer" Height="780" Width="1220" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/datasense_icon.png"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        Background="#0B1220"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ProcessIconConverter x:Key="ProcessIconConverter"/>
        <converters:ProcessColorConverter x:Key="ProcessColorConverter"/>

        <!-- Reusable premium card style with 1.02x hover elevation -->
        <Style x:Key="SummaryCardStyle" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="16"/>
            <Setter Property="Background" Value="#121C2E"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium History Card Style with 1.01x hover scale and soft border glow -->
        <Style x:Key="HistoryCardStyle" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="18"/>
            <Setter Property="Background" Value="#1B2433"/>
            <Setter Property="BorderBrush" Value="#2A364A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.01" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.01" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern GridView Header Style -->
        <Style x:Key="ModernGridViewHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#16202E"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#2A364A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ListView Style with Alternating Rows and Hover Highlights -->
        <Style x:Key="ModernListViewStyle" TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Margin" Value="0,1,0,1"/>
                        <Setter Property="Background" Value="#151E2B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                        <GridViewRowPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="Bd" Property="Background" Value="#253347"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="true">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Gradient Button -->
        <Style x:Key="PrimaryGradientButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <!-- Export PDF Button -->
        <Style x:Key="ExportPdfButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="38"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation (Width controlled by IsSidebarCollapsed) -->
            <ColumnDefinition Width="Auto"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="230"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="70" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="230" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand / Title -->
                    <RowDefinition Height="70"/>
                    <!-- Menu Navigation List -->
                    <RowDefinition Height="*"/>
                    <!-- App Health Status Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand logo and name -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <!-- Expanded brand row -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="ChartLineVariant" Width="26" Height="26" Foreground="{StaticResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="DataSense" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <!-- Collapsed: icon only centered -->
                    <materialDesign:PackIcon Kind="ChartLineVariant" Width="28" Height="28" Foreground="{StaticResource PrimaryHueMidBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <!-- Sidebar navigation items -->
                <ListBox Grid.Row="1" 
                         SelectedIndex="{Binding SelectedTabIndex}"
                         Background="Transparent" 
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource MaterialDesignListBoxItem}">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="20,14"/>
                            <Setter Property="Foreground" Value="#718096"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="{StaticResource SidebarSelectedBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>

                    <!-- Dashboard -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="ViewDashboardOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Dashboard" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- History -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="ChartBoxOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="History" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Alerts -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AlertCircleOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Alerts" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>


                    <!-- Speed Test -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Speedometer" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Speed Test" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                    <!-- Settings -->
                    <ListBoxItem Padding="0" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="SettingsOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </ListBoxItem>

                </ListBox>

                <!-- Sidebar footer status -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#1A202C" Padding="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="#00E5FF"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Npcap Active" Foreground="#A0AEC0" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORK AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header Bar -->
                <RowDefinition Height="70"/>
                <!-- Tab Switching Panel -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource MainHeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="#1A202C">
                <Grid Margin="12,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Toggle Button (small and simple DockLeft icon) -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            Foreground="#A0AEC0"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            ToolTip="Toggle Sidebar">
                        <materialDesign:PackIcon Kind="DockLeft" Width="18" Height="18"/>
                    </Button>

                    <!-- Title based on navigation selection -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Text" Value="Data Usage &amp; Traffic Analyzer"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Text" Value="Historical Reports &amp; Logs"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Text" Value="Data Limit Threshold Settings"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                        <Setter Property="Text" Value="Net Speed Testing"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                        <Setter Property="Text" Value="System Preferences &amp; Config"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- SILENT TAB CONTROL (Content switcher) -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 0: DASHBOARD REDESIGN (LAYOUT ONLY) -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">

                            <!-- HEADER -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="DataSense" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Network Usage Monitor" FontSize="14" Foreground="#718096" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- ROW 1: SIX SUMMARY CARDS -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Download Speed (with sparkline) -->
                                <materialDesign:Card Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="0,0,6,0">
                                    <Border CornerRadius="16" BorderThickness="1" Padding="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#16243A" Offset="0"/>
                                                <GradientStop Color="#0A1628" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00E5FF44" Offset="0"/>
                                                <GradientStop Color="#1E3A5A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.15"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2.5"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="36"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top accent bar: Blue -->
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00B4D8" Offset="0"/>
                                                        <GradientStop Color="#00E5FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Grid.Row="1" Kind="Download" Width="22" Height="22" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding DownloadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,2"/>
                                            <TextBlock Grid.Row="3" Text="Download Speed" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6" FontWeight="Medium"/>
                                            <!-- Mini sparkline -->
                                            <lvc:CartesianChart Grid.Row="4"
                                                Series="{Binding DownloadSparklineSeries}"
                                                XAxes="{Binding SparklineXAxes}"
                                                YAxes="{Binding SparklineYAxes}"
                                                Background="Transparent"
                                                LegendPosition="Hidden"
                                                Margin="-14,0,-14,-14"/>
                                        </Grid>
                                    </Border>
                                </materialDesign:Card>

                                <!-- Card 2: Upload Speed (with sparkline) -->
                                <materialDesign:Card Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="6,0,6,0">
                                    <Border CornerRadius="16" BorderThickness="1" Padding="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#1E1030" Offset="0"/>
                                                <GradientStop Color="#0A0A20" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E91E6344" Offset="0"/>
                                                <GradientStop Color="#2A1040" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2.5"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="36"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top accent bar: Purple -->
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#B5179E" Offset="0"/>
                                                        <GradientStop Color="#E91E63" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Grid.Row="1" Kind="Upload" Width="22" Height="22" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding UploadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,2"/>
                                            <TextBlock Grid.Row="3" Text="Upload Speed" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6" FontWeight="Medium"/>
                                            <!-- Mini sparkline -->
                                            <lvc:CartesianChart Grid.Row="4"
                                                Series="{Binding UploadSparklineSeries}"
                                                XAxes="{Binding SparklineXAxes}"
                                                YAxes="{Binding SparklineYAxes}"
                                                Background="Transparent"
                                                LegendPosition="Hidden"
                                                Margin="-14,0,-14,-14"/>
                                        </Grid>
                                    </Border>
                                </materialDesign:Card>

                                <!-- Card 3: Today Usage (clean) -->
                                <materialDesign:Card Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="6,0,6,0">
                                    <Border CornerRadius="16" BorderThickness="1" Padding="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#211800" Offset="0"/>
                                                <GradientStop Color="#0D0E18" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFB30044" Offset="0"/>
                                                <GradientStop Color="#1E1A10" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2.5"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top accent bar: Orange -->
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#E65100" Offset="0"/>
                                                        <GradientStop Color="#FFB300" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Grid.Row="1" Kind="CalendarToday" Width="22" Height="22" Foreground="#FFB300" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding DailyUsageText}" FontSize="28" FontWeight="Bold" Foreground="#FFB300" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,2"/>
                                            <TextBlock Grid.Row="3" Text="Today's Usage" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                </materialDesign:Card>

                                <!-- Card 4: Monthly Usage (clean) -->
                                <materialDesign:Card Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="6,0,6,0">
                                    <Border CornerRadius="16" BorderThickness="1" Padding="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0A1E30" Offset="0"/>
                                                <GradientStop Color="#050D18" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00B0FF44" Offset="0"/>
                                                <GradientStop Color="#0D1A2A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2.5"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top accent bar: Cyan -->
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#0077B6" Offset="0"/>
                                                        <GradientStop Color="#00B0FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Grid.Row="1" Kind="CalendarMonth" Width="22" Height="22" Foreground="#00B0FF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding MonthlyUsageText}" FontSize="28" FontWeight="Bold" Foreground="#00B0FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,2"/>
                                            <TextBlock Grid.Row="3" Text="Monthly Usage" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                </materialDesign:Card>

                                <!-- Card 5: Active Applications (clean) -->
                                <materialDesign:Card Grid.Column="4" Style="{StaticResource SummaryCardStyle}" Margin="6,0,6,0">
                                    <Border CornerRadius="16" BorderThickness="1" Padding="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#1E1500" Offset="0"/>
                                                <GradientStop Color="#0D0D0A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF980044" Offset="0"/>
                                                <GradientStop Color="#1E1600" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2.5"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top accent bar: Amber -->
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#E65100" Offset="0"/>
                                                        <GradientStop Color="#FF9800" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Grid.Row="1" Kind="Application" Width="22" Height="22" Foreground="#FF9800" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding ActiveAppsCount}" FontSize="28" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,2"/>
                                            <TextBlock Grid.Row="3" Text="Active Applications" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                </materialDesign:Card>

                                <!-- Card 6: Active Adapter (clean) -->
                                <materialDesign:Card Grid.Column="5" Style="{StaticResource SummaryCardStyle}" Margin="6,0,0,0">
                                    <Border CornerRadius="16" BorderThickness="1" Padding="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0A1E14" Offset="0"/>
                                                <GradientStop Color="#050E0A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#22C55E44" Offset="0"/>
                                                <GradientStop Color="#0A1E14" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2.5"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top accent bar: Green -->
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#15803D" Offset="0"/>
                                                        <GradientStop Color="#22C55E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Grid.Row="1" Kind="Network" Width="22" Height="22" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding SelectedAdapter.Name, FallbackValue='Ethernet'}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            <TextBlock Grid.Row="3" Text="Active Adapter" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                </materialDesign:Card>
                            </Grid>

                            <!-- ROW 2: LIVE NETWORK TRAFFIC SPEED (70%) & NETWORK OVERVIEW (30%) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left 70%: Live Network Traffic Speed Chart -->
                                <materialDesign:Card Grid.Column="0" UniformCornerRadius="18" Background="#161F2F" Padding="20">
                                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#2A364B" Background="#161F2F" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="220"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <materialDesign:PackIcon Kind="ChartLine" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Live Network Traffic Speed" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <lvc:CartesianChart Grid.Row="1" Series="{Binding SpeedSeries}" XAxes="{Binding SpeedXAxes}" YAxes="{Binding SpeedYAxes}" Background="Transparent" LegendPosition="Hidden"/>
                                        </Grid>
                                    </Border>
                                </materialDesign:Card>

                                <!-- Right 30%: Connection Details -->
                                <materialDesign:Card Grid.Column="2" UniformCornerRadius="18" Background="#161F2F" Padding="20">
                                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#2A364B" Background="#161F2F" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Connection Details" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" Margin="0,0,0,18"/>

                                            <!-- Network Type -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Wifi" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="Network Type" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnNetworkType}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14"/>

                                            <!-- Signal Strength -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="SignalCellular3" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="Signal Strength" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnSignalStrength}" Foreground="#34D399" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14"/>

                                            <!-- IP Address -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Ip" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="IP Address" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnIpAddress}" Foreground="#60A5FA" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14"/>

                                            <!-- DNS Server -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Dns" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="DNS Server" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnDnsServer}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14"/>

                                            <!-- Gateway -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Router" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="Gateway" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnGateway}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </materialDesign:Card>
                            </Grid>

                            <!-- ROW 3: PROCESS NETWORK TRAFFIC TABLE -->
                            <materialDesign:Card UniformCornerRadius="18" Background="#161F2F" Padding="20" Margin="0,0,0,20">
                                <Border CornerRadius="18" BorderThickness="1" BorderBrush="#2A364B" Background="#161F2F" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Process Network Traffic" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                        
                                        <!-- Header Row with Proportional Columns (30% / 15% / 15% / 20% / 20%) -->
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#2A364B" Padding="0,0,0,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>    <!-- Application 30% -->
                                                    <ColumnDefinition Width="1.5*"/>  <!-- Download Speed 15% -->
                                                    <ColumnDefinition Width="1.5*"/>  <!-- Upload Speed 15% -->
                                                    <ColumnDefinition Width="2*"/>    <!-- Today's Usage 20% -->
                                                    <ColumnDefinition Width="2*"/>    <!-- Monthly Usage 20% -->
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Application" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Padding="14,0"/>
                                                <TextBlock Grid.Column="1" Text="Download Speed" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>
                                                <TextBlock Grid.Column="2" Text="Upload Speed" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>
                                                <TextBlock Grid.Column="3" Text="Today's Usage" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>
                                                <TextBlock Grid.Column="4" Text="Monthly Usage" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Full-Width Process ListBox -->
                                        <ListBox ItemsSource="{Binding TopProcesses}" MaxHeight="260" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="44" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*"/>    <!-- Application 30% -->
                                                            <ColumnDefinition Width="1.5*"/>  <!-- Download Speed 15% -->
                                                            <ColumnDefinition Width="1.5*"/>  <!-- Upload Speed 15% -->
                                                            <ColumnDefinition Width="2*"/>    <!-- Today's Usage 20% -->
                                                            <ColumnDefinition Width="2*"/>    <!-- Monthly Usage 20% -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Col 0: Application (Icon + Name with 10px spacing) -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                                            <Image Source="{Binding ProcessName, Converter={StaticResource ProcessIconConverter}}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <materialDesign:PackIcon Kind="Application" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ProcessName, Converter={StaticResource ProcessIconConverter}}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                            <TextBlock Text="{Binding ProcessName}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- Col 1: Download Speed -->
                                                        <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>

                                                        <!-- Col 2: Upload Speed -->
                                                        <TextBlock Grid.Column="2" Text="{Binding UploadSpeedText}" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>

                                                        <!-- Col 3: Today Usage -->
                                                        <TextBlock Grid.Column="3" Text="{Binding TodayUsageText}" Foreground="#FFB300" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>

                                                        <!-- Col 4: Monthly Usage -->
                                                        <TextBlock Grid.Column="4" Text="{Binding MonthlyUsageText}" Foreground="#00B0FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="14,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="0,2,0,2"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#2A364B"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#334155"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </materialDesign:Card>

                            <!-- ROW 4: TOP DATA CONSUMERS (TWO EQUAL CARDS WITH SIDE-BY-SIDE CHART & LEGEND) -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Card: Today -->
                                <materialDesign:Card Grid.Column="0" UniformCornerRadius="18" Background="#161F2F">
                                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#2A364B" Background="#161F2F" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="Today" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                                            
                                            <!-- Side-by-Side Grid: Left 290px Chart, Right Legend -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>   <!-- Doughnut Chart -->
                                                    <ColumnDefinition Width="24"/>     <!-- 24px Gap -->
                                                    <ColumnDefinition Width="*"/>      <!-- Legend -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Large Doughnut Chart (290px) -->
                                                <Grid Grid.Column="0" Width="290" Height="290" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <lvc:PieChart Series="{Binding TodayDoughnutSeries}" LegendPosition="Hidden" Background="Transparent"/>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="Today's Total" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DailyUsageText}" FontSize="24" Foreground="#F8FAFC" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Right-Side Legend -->
                                                <ItemsControl x:Name="TodayLegendList" Grid.Column="2" ItemsSource="{Binding TodayTopProcesses}" VerticalAlignment="Center"
                                                              Tag="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,8" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Col 0: Dot + App Icon + Name -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="10" Height="10" Fill="{Binding ProcessName, Converter={StaticResource ProcessColorConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                    <Image Source="{Binding ProcessName, Converter={StaticResource ProcessIconConverter}}" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="Source" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <materialDesign:PackIcon Kind="Application" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <materialDesign:PackIcon.Style>
                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ProcessName, Converter={StaticResource ProcessIconConverter}}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </materialDesign:PackIcon.Style>
                                                                    </materialDesign:PackIcon>
                                                                    <TextBlock Text="{Binding ProcessName}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                                </StackPanel>

                                                                <!-- Col 1: Percentage Badge (Hidden on compact screens) -->
                                                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="10,4" Margin="14,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding PercentageText}" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Col 2: Total Usage (Hidden on compact screens) -->
                                                                <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="65" TextAlignment="Right"
                                                                           Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </materialDesign:Card>

                                <!-- Right Card: This Month -->
                                <materialDesign:Card Grid.Column="2" UniformCornerRadius="18" Background="#161F2F">
                                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#2A364B" Background="#161F2F" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="This Month" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                                            
                                            <!-- Side-by-Side Grid: Left 290px Chart, Right Legend -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>   <!-- Doughnut Chart -->
                                                    <ColumnDefinition Width="24"/>     <!-- 24px Gap -->
                                                    <ColumnDefinition Width="*"/>      <!-- Legend -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Large Doughnut Chart (290px) -->
                                                <Grid Grid.Column="0" Width="290" Height="290" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <lvc:PieChart Series="{Binding MonthlyDoughnutSeries}" LegendPosition="Hidden" Background="Transparent"/>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="Monthly Total" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding MonthlyUsageText}" FontSize="24" Foreground="#F8FAFC" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Right-Side Legend -->
                                                <ItemsControl x:Name="MonthlyLegendList" Grid.Column="2" ItemsSource="{Binding MonthlyTopProcesses}" VerticalAlignment="Center"
                                                              Tag="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,8" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Col 0: Dot + App Icon + Name -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="10" Height="10" Fill="{Binding ProcessName, Converter={StaticResource ProcessColorConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                    <Image Source="{Binding ProcessName, Converter={StaticResource ProcessIconConverter}}" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="Source" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <materialDesign:PackIcon Kind="Application" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <materialDesign:PackIcon.Style>
                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ProcessName, Converter={StaticResource ProcessIconConverter}}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </materialDesign:PackIcon.Style>
                                                                    </materialDesign:PackIcon>
                                                                    <TextBlock Text="{Binding ProcessName}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                                </StackPanel>

                                                                <!-- Col 1: Percentage Badge (Hidden on compact screens) -->
                                                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="10,4" Margin="14,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding PercentageText}" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Col 2: Total Usage (Hidden on compact screens) -->
                                                                <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="65" TextAlignment="Right"
                                                                           Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </materialDesign:Card>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 1: HISTORY VIEW -->
                <TabItem DataContext="{Binding History}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">

                            <!-- 1. Page Header -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="History &amp; Reports" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="View historical network usage, application statistics and export reports." FontSize="14" Foreground="#94A3B8"/>
                            </StackPanel>

                            <!-- 2. Filter Card -->
                            <materialDesign:Card Style="{StaticResource HistoryCardStyle}" Margin="0,0,0,20" Padding="20">
                                <DockPanel>
                                    <!-- Filters Left -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FilterVariant" Foreground="#38BDF8" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        
                                        <TextBlock Text="Year" Foreground="#94A3B8" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" 
                                                  Foreground="White" Width="95" Margin="0,0,24,0" FontSize="13" FontWeight="SemiBold"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,6"/>
                                        
                                        <TextBlock Text="Month" Foreground="#94A3B8" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding MonthOptions}" SelectedIndex="{Binding SelectedMonthIndex}" 
                                                  Foreground="White" Width="135" Margin="0,0,24,0" FontSize="13" FontWeight="SemiBold"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,6"/>
                                        
                                        <Button Style="{StaticResource PrimaryGradientButton}" Command="{Binding LoadCommand}" Content="Load History"/>
                                    </StackPanel>
                                    
                                    <!-- Action Right: Export PDF ONLY (CSV removed) -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ExportPdfButton}" Command="{Binding ExportToPdfCommand}" ToolTip="Export Current Log to PDF">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Export PDF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </materialDesign:Card>

                            <!-- 3. Daily Usage Overview Card -->
                            <materialDesign:Card Style="{StaticResource HistoryCardStyle}" Margin="0,0,0,20" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <materialDesign:PackIcon Kind="ChartBar" Foreground="#38BDF8" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Daily Usage Overview" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <lvc:CartesianChart Grid.Row="1"
                                                        Series="{Binding DailyChartSeries}"
                                                        XAxes="{Binding XAxes}"
                                                        YAxes="{Binding YAxes}"
                                                        DrawMarginFrame="{Binding HistoryDrawMarginFrame}"
                                                        Background="Transparent"
                                                        Height="400"
                                                        MinHeight="380"/>
                                </Grid>
                            </materialDesign:Card>

                            <!-- 4 & 5. Daily Breakdown & Monthly Top Applications (2-Column Layout) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Daily Breakdown Card -->
                                <materialDesign:Card Grid.Column="0" Style="{StaticResource HistoryCardStyle}" Margin="0,0,10,0" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <materialDesign:PackIcon Kind="CalendarClock" Foreground="#34D399" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Daily Breakdown" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Modern DataGrid / ListView -->
                                        <ListView Grid.Row="1" ItemsSource="{Binding DailyRows}" Style="{StaticResource ModernListViewStyle}" MaxHeight="320">
                                            <ListView.Resources>
                                                <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource ModernGridViewHeaderStyle}"/>
                                            </ListView.Resources>
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Date" Width="140">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Date}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Downloaded" Width="110">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Downloaded}" Foreground="#60A5FA" FontSize="13" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Uploaded" Width="110">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Uploaded}" Foreground="#34D399" FontSize="13" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Total Usage" Width="120">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Total}" Foreground="#F59E0B" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- Monthly Top Applications Card -->
                                <materialDesign:Card Grid.Column="1" Style="{StaticResource HistoryCardStyle}" Margin="10,0,0,0" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <materialDesign:PackIcon Kind="Apps" Foreground="#A78BFA" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Monthly Top Applications" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <ListView Grid.Row="1" ItemsSource="{Binding ProcessRows}" Style="{StaticResource ModernListViewStyle}" MaxHeight="320">
                                            <ListView.Resources>
                                                <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource ModernGridViewHeaderStyle}"/>
                                            </ListView.Resources>
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Application" Width="160">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Image Source="{Binding ProcessName, Converter={StaticResource ProcessIconConverter}}" 
                                                                           Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <TextBlock Text="{Binding ProcessName}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Downloaded" Width="95">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DownloadedText}" Foreground="#60A5FA" FontSize="13" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Uploaded" Width="95">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding UploadedText}" Foreground="#34D399" FontSize="13" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Total Usage" Width="100">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding TotalText}" Foreground="#F59E0B" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Grid>
                                </materialDesign:Card>
                            </Grid>

                            <!-- 6. Network Usage History Card -->
                            <materialDesign:Card Style="{StaticResource HistoryCardStyle}" Margin="0,0,0,20" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Wifi" Foreground="#38BDF8" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Network Usage History" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Sub Tabs: Monthly & Today Network Usage -->
                                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                        <TabControl.Resources>
                                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="Padding" Value="16,8"/>
                                            </Style>
                                        </TabControl.Resources>
                                        
                                        <TabItem Header="Selected Month Network Usage" Foreground="#38BDF8">
                                            <Grid Margin="0,12,0,0">
                                                <ListView ItemsSource="{Binding MonthlyNetworkRows}" Style="{StaticResource ModernListViewStyle}" MaxHeight="260">
                                                    <ListView.Resources>
                                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource ModernGridViewHeaderStyle}"/>
                                                    </ListView.Resources>
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Network Name" Width="280">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="WifiCheck" Foreground="#38BDF8" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding NetworkName}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Download" Width="150">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Downloaded}" Foreground="#60A5FA" FontSize="13" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Upload" Width="150">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Uploaded}" Foreground="#34D399" FontSize="13" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Total Usage" Width="160">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Total}" Foreground="#F59E0B" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Grid>
                                        </TabItem>

                                        <TabItem Header="Today's Live Network Usage" Foreground="#34D399">
                                            <Grid Margin="0,12,0,0">
                                                <ListView ItemsSource="{Binding NetworkRows}" Style="{StaticResource ModernListViewStyle}" MaxHeight="260">
                                                    <ListView.Resources>
                                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource ModernGridViewHeaderStyle}"/>
                                                    </ListView.Resources>
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Network Name" Width="280">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="WifiCheck" Foreground="#34D399" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding NetworkName}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Download" Width="150">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Downloaded}" Foreground="#60A5FA" FontSize="13" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Upload" Width="150">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Uploaded}" Foreground="#34D399" FontSize="13" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Total Usage" Width="160">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Total}" Foreground="#F59E0B" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </materialDesign:Card>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: DATA LIMITS VIEW -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Limit Settings Card -->
                        <materialDesign:Card Grid.Row="0" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,0,0,24" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Set Monthly Data Cap" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="White"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Monthly Limit (GB):" VerticalAlignment="Center" FontSize="15" Margin="0,0,16,0" Foreground="White"/>
                                    <TextBox Grid.Column="1" Text="{Binding MonthlyLimitGb, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontSize="16" Foreground="White" materialDesign:TextFieldAssist.HasClearButton="True"/>
                                    <Button Grid.Column="2" Command="{Binding SaveLimitCommand}" Content="Save Limit" Margin="16,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </Grid>

                                <Separator Margin="0,0,0,20" Background="#1A202C"/>

                                <TextBlock Text="Current Usage Cap Status" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="White"/>
                                <TextBlock Text="{Binding LimitUsageText}" FontSize="15" Margin="0,0,0,8" Foreground="{StaticResource PrimaryHueMidBrush}" FontWeight="SemiBold"/>
                                <ProgressBar Value="{Binding LimitUsagePercentage}" Height="12" Margin="0,0,0,8" Foreground="{StaticResource PrimaryHueMidBrush}" Background="#2D3748"/>
                                <Grid>
                                    <TextBlock Text="0%" HorizontalAlignment="Left" Foreground="Gray"/>
                                    <TextBlock Text="100%" HorizontalAlignment="Right" Foreground="Gray"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Threshold alert logs card -->
                        <materialDesign:Card Grid.Row="1" Background="{StaticResource MaterialDesignCardBackground}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Configured Alerts Thresholds" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Alert" Foreground="Green" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="50% Threshold Notification Alert active." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Alert" Foreground="Orange" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="75% Warning notification alert active." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Alert" Foreground="Red" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="90% Critical Alert notification active." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="DarkRed" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="100% Data Cap Reached notification and system action ready." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="You will receive real-time notifications in your system tray balloon tip when limits are breached." Foreground="Gray" FontSize="11" Margin="0,20,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>



                <!-- TAB 4: SPEED TEST LAYOUT -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">

                            <!-- 1. HEADER -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Speed Test" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Measure your internet connection performance in real time." FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 2. LARGE SPEED TEST CARD -->
                            <materialDesign:Card Style="{StaticResource HistoryCardStyle}" Padding="32" Margin="0,0,0,24">
                                <StackPanel HorizontalAlignment="Center">

                                    <!-- Gauge Circle -->
                                    <Grid Width="340" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <!-- Outer Ambient Glow Ring -->
                                        <Ellipse Width="336" Height="336" Stroke="#1E293B" StrokeThickness="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Track Background -->
                                        <Ellipse Width="300" Height="300" Stroke="#1E293B" StrokeThickness="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="300" Height="300" Stroke="#00BFFF" StrokeThickness="8" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Rotating Active Glow Ring while running -->
                                        <Ellipse Width="312" Height="312" Stroke="#00BFFF" StrokeThickness="3" Opacity="0.8"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Visibility="{Binding IsSpeedTestRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform CenterX="156" CenterY="156"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             From="0" To="360" Duration="0:0:1.5"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>

                                        <!-- Center Speed Value & Phase Display -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SpeedTestCurrentSpeedText}" FontSize="52" FontWeight="Black"
                                                       Foreground="#00BFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="MBps" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                            <!-- Phase Badge -->
                                            <Border Background="#1E293B" CornerRadius="12" Padding="12,4" Margin="0,12,0,0" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#00BFFF" Margin="0,0,8,0"
                                                             Visibility="{Binding IsSpeedTestRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding SpeedTestPhase}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Linear Progress Bar -->
                                    <ProgressBar Value="{Binding SpeedTestProgress}" Maximum="100" Height="6" Width="340"
                                                 Margin="0,24,0,24" Foreground="#00BFFF" Background="#1E293B"/>

                                    <!-- Action Button -->
                                    <Button Width="260" Height="50"
                                            Command="{Binding RunSpeedTestCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="25"
                                            Background="#00BFFF" Foreground="#0F172A"
                                            FontWeight="Bold" FontSize="15">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#00BFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                                        </Button.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Speedometer" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Start Speed Test"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSpeedTestRunning}" Value="True">
                                                                <Setter Property="Text" Value="Stop Test"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:Card>


                            <!-- 3. FOUR RESULT CARDS (Download, Upload, Ping, Jitter) -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- DOWNLOAD CARD (Blue #00BFFF) -->
                                <materialDesign:Card Grid.Column="0" Style="{StaticResource HistoryCardStyle}" Margin="0,0,8,0" Padding="18">
                                    <Grid>
                                        <Border Height="4" VerticalAlignment="Top" Background="#00BFFF" CornerRadius="2" Margin="-18,-18,-18,0"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="DOWNLOAD" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="DownloadNetwork" Width="20" Height="20" Foreground="#00BFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SpeedTestDownloadText}" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- UPLOAD CARD (Purple #9C27B0) -->
                                <materialDesign:Card Grid.Column="1" Style="{StaticResource HistoryCardStyle}" Margin="8,0,8,0" Padding="18">
                                    <Grid>
                                        <Border Height="4" VerticalAlignment="Top" Background="#9C27B0" CornerRadius="2" Margin="-18,-18,-18,0"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="UPLOAD" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="UploadNetwork" Width="20" Height="20" Foreground="#9C27B0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SpeedTestUploadText}" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- PING CARD (Green #22C55E) -->
                                <materialDesign:Card Grid.Column="2" Style="{StaticResource HistoryCardStyle}" Margin="8,0,8,0" Padding="18">
                                    <Grid>
                                        <Border Height="4" VerticalAlignment="Top" Background="#22C55E" CornerRadius="2" Margin="-18,-18,-18,0"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="PING" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="Speedometer" Width="20" Height="20" Foreground="#22C55E" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SpeedTestPingText}" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- JITTER CARD (Amber #F59E0B) -->
                                <materialDesign:Card Grid.Column="3" Style="{StaticResource HistoryCardStyle}" Margin="8,0,0,0" Padding="18">
                                    <Grid>
                                        <Border Height="4" VerticalAlignment="Top" Background="#F59E0B" CornerRadius="2" Margin="-18,-18,-18,0"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="JITTER" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="Waveform" Width="20" Height="20" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SpeedTestJitterText}" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </Grid>


                            <!-- 5. INFORMATION CARDS (Connection & Server Info) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT CARD: CONNECTION INFORMATION -->
                                <materialDesign:Card Grid.Column="0" Style="{StaticResource HistoryCardStyle}" Margin="0,0,10,0" Padding="20">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <materialDesign:PackIcon Kind="Lan" Width="20" Height="20" Foreground="#00BFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Connection Information" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>

                                        <Grid Margin="0,4,0,10">
                                            <TextBlock Text="Network Name" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedAdapter.NetworkName, FallbackValue='Active Network'}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Separator Background="#2A364A"/>

                                        <Grid Margin="0,10,0,10">
                                            <TextBlock Text="Adapter" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedAdapter.Name, FallbackValue='Wi-Fi Adapter'}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Separator Background="#2A364A"/>

                                        <Grid Margin="0,10,0,10">
                                            <TextBlock Text="ISP" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SpeedTestIsp}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Separator Background="#2A364A"/>

                                        <Grid Margin="0,10,0,4">
                                            <TextBlock Text="External IP" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SpeedTestIp}" Foreground="#00BFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- RIGHT CARD: SERVER INFORMATION -->
                                <materialDesign:Card Grid.Column="1" Style="{StaticResource HistoryCardStyle}" Margin="10,0,0,0" Padding="20">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <materialDesign:PackIcon Kind="ServerNetwork" Width="20" Height="20" Foreground="#9C27B0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Server Information" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>

                                        <Grid Margin="0,4,0,10">
                                            <TextBlock Text="Server Location" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SpeedTestServer}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Separator Background="#2A364A"/>

                                        <Grid Margin="0,10,0,10">
                                            <TextBlock Text="Latency" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SpeedTestPingText}" Foreground="#22C55E" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Separator Background="#2A364A"/>

                                        <Grid Margin="0,10,0,10">
                                            <TextBlock Text="Jitter" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SpeedTestJitterText}" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Separator Background="#2A364A"/>

                                        <Grid Margin="0,10,0,4">
                                            <TextBlock Text="Test Status" Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding SpeedTestPhase}" Foreground="#9C27B0" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: SETTINGS -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Preferences settings -->
                        <materialDesign:Card Grid.Row="0" Background="{StaticResource MaterialDesignCardBackground}" Margin="0,0,0,24" Padding="24">
                            <StackPanel>
                                <TextBlock Text="General Preferences" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                                <!-- Startup Toggle -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start DataSense with Windows" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Automatically launches DataSense when your PC starts up to track all metrics." Foreground="Gray"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsStartupEnabled}" Command="{Binding ToggleStartupCommand}"/>
                                </Grid>

                                <Separator Margin="0,0,0,16" Background="#1A202C"/>

                                <!-- Dark Theme Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Enable Dark Theme Layout" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Switch background layout to a comfortable midnight slate theme." Foreground="Gray"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsDarkTheme}" Command="{Binding ToggleThemeCommand}"/>
                                </Grid>

                                <Separator Margin="0,16,0,16" Background="#1A202C"/>

                                <!-- Net Speed Meter Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Speedometer" Foreground="#4FC3F7" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Net Speed Meter Overlay" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Show a real-time transparent upload/download speed meter on your taskbar. Drag to reposition." Foreground="Gray" Margin="26,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsNetSpeedMeterEnabled}" Command="{Binding ToggleNetSpeedMeterCommand}"/>
                                </Grid>

                                <Separator Margin="0,16,0,16" Background="#1A202C"/>

                                <!-- Pin Net Speed Meter to Taskbar Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pin" Foreground="#EF5350" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Pin Speed Meter to Taskbar" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Locks the speed meter position directly onto the taskbar (next to the system tray clock)." Foreground="Gray" Margin="26,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsNetSpeedMeterPinned}" Command="{Binding ToggleNetSpeedMeterPinnedCommand}"/>
                                </Grid>

                                <Separator Margin="0,16,0,16" Background="#1A202C"/>

                                <!-- Customization Options (Color &amp; Size) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Palette" Foreground="#81C784" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Speed Meter Customization" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Configure the font color and text size of the speed overlay." Foreground="Gray" Margin="26,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Color Selection -->
                                        <ComboBox Width="110" Margin="0,0,12,0"
                                                  ItemsSource="{Binding NetSpeedMeterAvailableColors}"
                                                  SelectedItem="{Binding SelectedNetSpeedMeterColor}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Color"
                                                  Foreground="White"
                                                  BorderBrush="#33FFFFFF"/>
                                        <!-- Font Size Selection -->
                                        <ComboBox Width="80"
                                                  ItemsSource="{Binding NetSpeedMeterAvailableFontSizes}"
                                                  SelectedItem="{Binding SelectedNetSpeedMeterFontSize}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Size"
                                                  Foreground="White"
                                                  BorderBrush="#33FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Adapter Selection Card -->
                        <materialDesign:Card Grid.Row="1" Background="{StaticResource MaterialDesignCardBackground}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Select Network Adapter to Monitor" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="White"/>
                                <TextBlock Text="Choose which physical Ethernet or Wi-Fi adapter's raw packets will be captured by the Npcap engine:" Margin="0,0,0,16" Foreground="Gray"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableAdapters}" SelectedItem="{Binding SelectedAdapter}" FontSize="14" DisplayMemberPath="Name" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding ChangeAdapterCommand}" Content="Apply Adapter" Margin="16,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
